# TreeForLife Environment Configuration
# Full reference: docs/DEPLOYMENT.md §2

# Database (optional locally)
# Unset → embedded PGlite under .data/pglite (local dev only).
# Production → Supabase Transaction pooler URI (port 6543):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# DB_POOL_MAX=3

# Back office gate (required in production; unset there = /admin disabled)
# ADMIN_PASSWORD=change-me

# Application Settings
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# LINE Official Account ID without the leading "@"
NEXT_PUBLIC_LINE_OA_ID=treeforlife
