# TreeForLife Configuration

# Public Base URL
NEXT_PUBLIC_BASE_URL=https://treeforlife.shop

# LINE Official Account ID (without @)
NEXT_PUBLIC_LINE_OA_ID=treeforlife

# Database Connection (Optional: If omitted, TreeForLife uses embedded PGlite locally)
# DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cron Secret for scheduled tasks
CRON_SECRET=your_secret_cron_token_here
